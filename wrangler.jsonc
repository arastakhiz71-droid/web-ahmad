{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ahmad",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "18a317cc-a550-4d75-9bc9-7e50681e5212","database_name": "web-ahmad" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "736e7e22f5894b7c97180a611dc32d9a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
